<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/stringee_surface" />
            <stroke android:width="1dp" android:color="@color/stringee_disabled" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#0FFF4954" />
            <stroke android:width="1dp" android:color="@color/redDark" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/stringee_surface" />
            <stroke android:width="1dp" android:color="@color/redLight" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
