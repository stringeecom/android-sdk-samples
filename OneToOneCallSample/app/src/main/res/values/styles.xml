<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/stringee_surface</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowBackground">@color/stringee_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="StringeeActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/colorPrimary</item>
        <item name="titleTextStyle">@style/StringeeActionBarTitle</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="StringeeActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StringeeSectionTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/stringee_ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StringeeSubsectionTitle" parent="TextAppearance.AppCompat.Subhead">
        <item name="android:textColor">@color/stringee_ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StringeeBodyText" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/stringee_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="StringeeButtonPrimary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_stringee_button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/stringee_primary_button_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StringeeButtonSecondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_stringee_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/stringee_secondary_button_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StringeeButtonVoice" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_stringee_button_voice</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StringeeButtonVideo" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_stringee_button_video</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:textColor">@color/stringee_navy</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="StringeeTextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/stringee_red_strong</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
